# =============================================================================
# Saudi Dropshipping AI Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables have sensible defaults for local development.
# Only secrets marked [REQUIRED FOR X] must be set for that feature to work.

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
# Option 1: Split variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saudi_dropshipping
DB_USER=postgres
DB_PASSWORD=your_db_password          # [REQUIRED FOR DB] Set to enable database persistence
DB_SSL=false
# Option 2: Single connection string (takes priority if set)
# DATABASE_URL=postgresql://user:password@host:5432/saudi_dropshipping

# --- Salla Merchant API ---
# Register at https://salla.partners/ to get credentials
SALLA_CLIENT_ID=                      # [REQUIRED FOR SALLA]
SALLA_CLIENT_SECRET=                  # [REQUIRED FOR SALLA]
SALLA_REDIRECT_URI=http://localhost:3000/api/v1/salla/callback
SALLA_ACCESS_TOKEN=                   # [REQUIRED FOR SALLA] Obtained via OAuth flow
SALLA_REFRESH_TOKEN=
SALLA_STORE_ID=

# --- LLM (Arabic content generation) ---
OPENAI_API_KEY=                       # [OPTIONAL] Enables AI-generated marketing content
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=                    # [OPTIONAL] Alternative to OpenAI
LLM_PROVIDER=openai                   # openai | anthropic

# --- Supplier APIs ---
# AliExpress Official API
ALIEXPRESS_APP_KEY=                   # [OPTIONAL] For official AliExpress API
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=

# Alibaba Official API
ALIBABA_APP_KEY=                      # [OPTIONAL] For official Alibaba API
ALIBABA_APP_SECRET=

# RapidAPI (AliExpress live discovery)
RAPIDAPI_KEY=                         # [OPTIONAL] Enables live AliExpress product search
RAPIDAPI_HOST=alibaba-datahub.p.rapidapi.com

# --- Admin Security ---
ADMIN_API_KEY=dev_admin_key_123       # [CHANGE IN PRODUCTION] API key for all authenticated endpoints
JWT_SECRET=dev_jwt_secret_123         # [CHANGE IN PRODUCTION]

# --- n8n Automation ---
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=                          # [OPTIONAL] Enables n8n webhook integration

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Discovery Settings ---
DISCOVERY_MIN_RELEVANCE=55
DISCOVERY_MARKETING_MIN_SCORE=70

# --- Feature Flags ---
ENABLE_AUTO_PUSH_TO_SALLA=false
REQUIRE_APPROVAL=true
ENABLE_MARKETING_QUEUE=true
