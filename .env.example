# =============================================================================
# Saudi Dropshipping AI Agent - Environment Configuration
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saudi_dropshipping
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL=false

# --- Salla Merchant API ---
# Register at https://salla.partners/ to get credentials
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=http://localhost:3000/api/v1/salla/callback
SALLA_ACCESS_TOKEN=
SALLA_REFRESH_TOKEN=
SALLA_STORE_ID=

# --- OpenAI / LLM (for Arabic content generation) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Alternative: use Anthropic
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai

# --- Supplier APIs ---
# AliExpress affiliate/dropshipping API
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=

# Alibaba (if using official API)
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# --- Google Trends ---
# No API key needed for unofficial access; rate-limited

# --- Admin Security ---
ADMIN_API_KEY=your_admin_api_key_here
JWT_SECRET=your_jwt_secret_here

# --- n8n ---
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- RapidAPI (AliExpress live discovery) ---
RAPIDAPI_KEY=
RAPIDAPI_HOST=alibaba-datahub.p.rapidapi.com

# --- Feature Flags ---
ENABLE_AUTO_PUSH_TO_SALLA=false
REQUIRE_APPROVAL=true
ENABLE_MARKETING_QUEUE=true
